# Example broker configuration - copy to <config store datadir>/config_graph.ttl.
# Every setting is optional; the values below are the built-in defaults, except
# where a comment says the setting has none. See docs/configuration.md.
@prefix broker: <https://catalog-broker.ds-labs.org/ontologies/config#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<urn:ds-catalog-broker:config> a broker:BrokerConfig ;
    # Address the HTTP API listens on.
    broker:httpApiAddr "127.0.0.1:8080" ;

    # Participants to crawl, described below. No default: with none, no crawler
    # runs and every route, /sparql included, answers from an empty store.
    broker:participant <urn:ds-catalog-broker:participant:a>,
        <urn:ds-catalog-broker:participant:dcp>,
        <urn:ds-catalog-broker:participant:oid4vp> ;

    # The crawler's own holder identity, described below. Needed only when a
    # participant uses the dcp or oid4vp credential protocol.
    broker:holder <urn:ds-catalog-broker:holder> ;

    # Harvesting: how often a full crawl cycle runs, how long one participant's
    # crawl may take, how many participants are crawled at once, and how long a
    # catalog stays cached after its participant's last successful crawl.
    broker:crawlIntervalSecs 300 ;
    broker:crawlTimeoutMs 30000 ;
    broker:crawlConcurrency 8 ;
    broker:catalogMaxAgeSecs 86400 ;

    # OAuth2 Bearer gating of /catalog and /sparql. No defaults: an unset
    # oauth2JwksUri leaves both routes unauthenticated, and each of the other
    # three is checked only when set.
    broker:oauth2JwksUri "https://auth.example.org/.well-known/jwks.json" ;
    broker:oauth2Issuer "https://auth.example.org" ;
    broker:oauth2Audience "ds-catalog-broker" ;
    broker:oauth2RequiredScope "catalog:read" ;

    # Bounds on one /sparql evaluation.
    broker:sparqlQueryTimeoutMs 10000 ;
    broker:sparqlMaxRows 10000 ;
    broker:sparqlMaxConcurrent 4 ;

    # ODRL policy-based dataset visibility filtering.
    broker:policyFilterUnmappableConstraintAction "hide_dataset" ; # skip | drop_policy | hide_dataset
    broker:policyFilterNoPolicyVisibility "open" ;                 # open | closed
    broker:policyFilterRunWhenOauth2Disabled true ;

    # Seconds between SIGTERM and closing the listener, while /ready already
    # answers 503 (see docs/operations.md). Unset: no delay.
    broker:shutdownDelaySecs 5 .

# An open participant: no credential is presented (credentialProtocol "none",
# the default).
<urn:ds-catalog-broker:participant:a> a broker:Participant ;
    broker:participantId "participant-a" ;
    broker:participantName "Participant A" ;
    broker:catalogRequestUrl "http://127.0.0.1:19001/dsp/catalog/request" .

# A participant gated by a DCP self-issued token: needs its own DID.
<urn:ds-catalog-broker:participant:dcp> a broker:Participant ;
    broker:participantId "gated-participant" ;
    broker:participantName "DCP-gated participant" ;
    broker:catalogRequestUrl "http://127.0.0.1:19002/dsp/catalog/request" ;
    broker:credentialProtocol "dcp" ;
    broker:providerDid "did:web:localhost%3A19002:dsp" .

# A participant gated by an OID4VP presentation: needs its response URI.
<urn:ds-catalog-broker:participant:oid4vp> a broker:Participant ;
    broker:participantId "oid4vp-gated-participant" ;
    broker:participantName "OID4VP-gated participant" ;
    broker:catalogRequestUrl "http://127.0.0.1:19003/dsp/catalog/request" ;
    broker:credentialProtocol "oid4vp" ;
    broker:oid4vpResponseUri "http://127.0.0.1:19003/oid4vp/response" .

# The crawler's holder identity. The credential (a JWS compact string) is read
# from a local file at startup, so it never sits in this document.
<urn:ds-catalog-broker:holder> a broker:Holder ;
    broker:ownDidHost "localhost:19100" ;
    broker:insecureHttp true ;   # default false
    broker:credentialJwsFile "/etc/ds-catalog-broker/holder-credential.jws" ;
    broker:requiredScope "org.eclipse.dspace.dcp.vc.type:FederatedCatalogAccessCredential:read" .
